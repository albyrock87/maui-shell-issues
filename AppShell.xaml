<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="shell_issues.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:shell_issues"
    xmlns:dx="http://schemas.devexpress.com/maui"
    Shell.FlyoutBehavior="Flyout"
    Title="shell_issues">

    <Shell.FlyoutHeader>
        <VerticalStackLayout>
            <local:MyLabel Text="A label in the flyout header" />
            <dx:DXButton Margin="16" Content="Surprise!" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>
    
    <ShellContent ContentTemplate="{DataTemplate local:MainPage}"
                  Title="Home"
                  Route="Home"/>

    <ShellContent ContentTemplate="{DataTemplate local:FooPage}"
                  Title="Foo"
                  Route="Foo"/>

</Shell>
