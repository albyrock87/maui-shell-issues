<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shellIssues="clr-namespace:shell_issues"
             x:Class="shell_issues.BarPage"
             x:DataType="shellIssues:SampleSingleton">
    <ContentPage.Content>
        <Button
            x:Name="TheButton"
            Command="{Binding DumbActionCommand}"
            Margin="16"
            HeightRequest="80"
            CornerRadius="0"
            Text="A button with a noop command"
            VerticalOptions="End" />
    </ContentPage.Content>
</ContentPage>